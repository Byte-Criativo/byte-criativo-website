# Formulário de contato. Copie para .env.local apenas no desenvolvimento.
# Não use a chave real em arquivos versionados.
RESEND_API_KEY=
# Use um remetente de domínio verificado no Resend em produção.
LEAD_EMAIL_FROM="Site Byte Criativo <contato@bcriativo.com>"
# Caixa monitorada pela equipe; o padrão no código é contato@bcriativo.com.
LEAD_EMAIL_TO=contato@bcriativo.com
