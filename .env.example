# Formulário de contato. Copie para .env.local apenas no desenvolvimento.
# Não use a chave real em arquivos versionados.
RESEND_API_KEY=
# Use um remetente de domínio verificado no Resend em produção.
LEAD_EMAIL_FROM="Site Byte Criativo <contato@bcriativo.com>"
# Destinatário privado dos leads (obrigatório para envio real).
# Configure o endereço final diretamente no ambiente de produção.
LEAD_EMAIL_TO=destinatario@exemplo.com
# Cloudflare Turnstile Free: chave pública do widget e secret de validação.
# O formulário não envia e-mail sem o secret e um token válido.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
