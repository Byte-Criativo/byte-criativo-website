{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "url": ["http://localhost:3000/"],
      "numberOfRuns": 3,
      "settings": { "formFactor": "mobile" }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 3800 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 150 }],
        "resource-summary:script:size": [
          "error",
          { "maxNumericValue": 165000 }
        ],
        "resource-summary:font:size": ["error", { "maxNumericValue": 150000 }],
        "resource-summary:stylesheet:size": [
          "error",
          { "maxNumericValue": 46080 }
        ],
        "total-byte-weight": ["error", { "maxNumericValue": 1572864 }],
        "resource-summary:third-party:count": [
          "error",
          { "maxNumericValue": 0 }
        ],
        "categories:accessibility": ["error", { "minScore": 1 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
